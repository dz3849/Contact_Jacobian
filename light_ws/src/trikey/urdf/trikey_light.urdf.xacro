<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="trikey_light">

   <!-- Central Body -->
    <link name="base_link">
        <!-- <inertial>
            <origin xyz="0.0 0.0 1.0" rpy="0.0 0.0 0.0"/>
            <mass value="3.0"/>
            <inertia ixx="2.0" ixy="0.0" ixz="0.0" iyy="2.0" iyz="0.0" izz="2.0"/>
        </inertial> -->
        <visual>
            <origin xyz="0.0 0.0 1" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.6" length="0.5"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 1.2" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.6" length="0.5"/>
            </geometry>
        </collision>
    </link>


<!-- Body Link (Raises Center of Mass)-->
    <link name="body_link">
        <inertial>
            <origin xyz="0.0 0.0 0" rpy="0.0 0.0 0.0"/>
            <mass value="20"/>
            <inertia ixx="2.0" ixy="0.0" ixz="0.0" iyy="2.0" iyz="0.0" izz="2.0"/>
        </inertial>
        <visual>
            <origin xyz="0.0 0.0 0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.6" length="0.5"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.0 0.0 0" rpy="0.0 0.0 0.0"/>
            <geometry>
                <cylinder radius="0.6" length="0.5"/>
            </geometry>
        </collision>
    </link>

<!-- Body to Center Joint -->
<joint name="center_joint" type="fixed">
    <origin xyz="0 0 0.5" rpy="0 0 0"/>
    <child link="body_link"/>
    <parent link="base_link"/>
</joint>


  <xacro:macro name="shaft_wheel" params="id x y rpy">
    <!-- Shaft -->
    <link name="shaft_link_${id}">
      <inertial>
        <origin xyz="0.0 1.2 1.0" rpy="1.5708 0.0 0.0"/>
        <mass value="5"/>
        <inertia ixx="1.333" ixy="0.0" ixz="0.0" iyy="0.0" iyz="0.0" izz="1.333"/>
      </inertial>
      <visual>
        <origin xyz="0.0 1.2 1.0" rpy="1.5708 0.0 0.0"/>
        <geometry>
          <cylinder radius="0.5" length="2"/>
        </geometry>
        <material name="red">
          <color rgba="1.0 0.0 0.0 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.0 1.2 1.0" rpy="1.5708 0.0 0.0"/>
        <geometry>
          <cylinder radius="0.5" length="2"/>
        </geometry>
      </collision>
    </link>

    <!-- Fixed joint attaching the shaft to the robot base -->
    <joint name="base_joint_${id}" type="fixed">
      <origin xyz="${x} ${y} -0.5" rpy="0.0 0.0 ${rpy}"/>
      <parent link="base_link"/>
      <child link="shaft_link_${id}"/>
    </joint>

    <!-- Wheel Link -->
    <link name="wheel_link_${id}">
      <inertial>
        <origin xyz="0.0 0.0 -0.2" rpy="0.0 0.0 0.0"/>
        <mass value="2"/>
        <inertia ixx="0.25" ixy="0.0" ixz="0.0" iyy="0.25" iyz="0.0" izz="0.5"/>
      </inertial>
      <visual>
        <origin xyz="0.0 0.0 -0.2" rpy="0.0 0.0 0.0"/>
        <geometry>
          <cylinder radius="1.0" length="0.3"/>
        </geometry>
        <material name="black">
          <color rgba="0.0 0.0 0.0 1.0"/>
        </material>
      </visual>
      <surface>
        <friction>
          <ode>
            <mu>10</mu>
            <mu2>0.1</mu2>
          </ode>
        </friction>
        <contact>
          <ode>
              <kp>1e5</kp>
              <kd>1e3</kd>
              <max_vel>2</max_vel>
              <min_depth>0.003</min_depth>
          </ode>
        </contact>
      </surface>
      <collision>
        <origin xyz="0.0 0.0 -0.2" rpy="0.0 0.0 0.0"/>
        <geometry>
          <cylinder radius="1.0" length="0.3"/>
        </geometry>
      </collision>
    </link>

    <!-- Continuous joint connecting the shaft to the wheel, with embedded FT sensor -->
    <joint name="wheel_joint_${id}" type="continuous">
      <origin xyz="0.0 2.0 1.0" rpy="1.57 0.0 0.0"/>
      <parent link="shaft_link_${id}"/>
      <child link="wheel_link_${id}"/>
      <axis xyz="0.0 0.0 1.0"/>
      <limit effort="300.0" velocity="10.0"/>
    <provideFeedback>true</provideFeedback>
      <physics>
            <provideFeedback>true</provideFeedback>
        </physics>
      <gazebo>
            <physics>
            <provideFeedback>true</provideFeedback>
            </physics>
            <provideFeedback>true</provideFeedback>
        <sensor type="force_torque" name="ft_sensor_wheel_${id}">
          <always_on>true</always_on>
          <update_rate>1000</update_rate>
          <force_torque>
            <frame>child</frame>
                        <measure_direction>child_to_parent</measure_direction>
          </force_torque>
        </sensor>
      </gazebo>
    </joint>

    

    <!-- Transmission referencing the continuous joint -->
    <transmission name="wheel_joint_transmission_${id}">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="wheel_joint_${id}">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
      </joint>
      <actuator name="wheel_motor_${id}">
        <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
    <gazebo reference="wheel_joint_${id}">
        <provideFeedback>true</provideFeedback>
    </gazebo>
  </xacro:macro>

  <!-- Instantiate three shaft/wheel assemblies at 0°, +120°, -120° -->
  <xacro:property name="r" value="-1"/>
  <!-- Angles in radians -->
  <xacro:property name="theta1" value="0.0"/>
  <xacro:property name="theta2" value="2.0943951"/>    <!-- 120 deg -->
  <xacro:property name="theta3" value="-2.0943951"/>   <!-- -120 deg -->
  <!-- Additional rotation if needed -->
  <xacro:property name="rotate90" value="1.5708"/>

  <xacro:shaft_wheel
      id="1"
      x="${r * cos(theta1)}"
      y="${r * sin(theta1)}"
      rpy="${theta1 + rotate90}"
  />
  <xacro:shaft_wheel
      id="2"
      x="${r * cos(theta2)}"
      y="${r * sin(theta2)}"
      rpy="${theta2 + rotate90}"
  />
  <xacro:shaft_wheel
      id="3"
      x="${r * cos(theta3)}"
      y="${r * sin(theta3)}"
      rpy="${theta3 + rotate90}"
  />

  <!-- Macro to add a cover bar for a wheel -->
<xacro:macro name="wheel_cover_bar" params="id pos_x pos_y pos_z rpy_x rpy_y rpy_z length">
  <link name="wheel_cover_${id}">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
    <visual>
      <!-- The cylinder represents the bar cover. Its radius matches the roll cage (0.3) -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="${length}"/>
      </geometry>
      <material name="cover_material">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.3" length="${length}"/>
      </geometry>
    </collision>
  </link>

  <joint name="wheel_cover_joint_${id}" type="fixed">
    <origin xyz="${pos_x} ${pos_y} ${pos_z}" rpy="${rpy_x} ${rpy_y} ${rpy_z}"/>
    <parent link="base_link"/>
    <child link="wheel_cover_${id}"/>
  </joint>
</xacro:macro>

<xacro:wheel_cover_bar 
    id="1" 
    pos_x="-4.4" pos_y="0" pos_z="1" 
    rpy_x="0" rpy_y="1.5708" rpy_z="1.5708" 
    length="1.65"/>

<!-- Cover for Wheel 2 (located at (0.5,-0.866)) -->
<xacro:wheel_cover_bar 
    id="2" 
    pos_x="2.2" pos_y="-3.81" pos_z="1" 
    rpy_x="0" rpy_y="1.5708" rpy_z="-2.61799" 
    length="1.65"/>

<!-- Cover bar for Wheel 3 (connecting rollcage_23 and rollcage_31) -->
<xacro:wheel_cover_bar 
    id="3" 
    pos_x="2.2" pos_y="3.81" pos_z="1" 
    rpy_x="0" rpy_y="1.5708" rpy_z="2.61799" 
    length="1.65"/>

  <!-- Roll Cage Beam between wheel 1 and wheel 2 -->
  <link name="rollcage_12">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <!-- Midpoint at (-0.25, -0.433, 0), rotated so the cylinder lies along the beam -->
      <origin xyz="-1.615 -2.79718 1" rpy="0 -1.5708 -0.5236"/>
      <geometry>
               <cylinder radius="0.3" length="6.7"/>

      </geometry>
      <material name="silver">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-1.615 -2.79718 1" rpy="0 -1.5708 -0.5236"/>
      <geometry>
                <cylinder radius="0.3" length="6.7"/>

      </geometry>
    </collision>
  </link>
  <joint name="rollcage_joint_12" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rollcage_12"/>
  </joint>

  <!-- Roll Cage Beam between wheel 2 and wheel 3 -->
  <link name="rollcage_23">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <!-- Midpoint at (0.5, 0, 0); beam angle ψ = +1.5708 rad -->
      <origin xyz="3.23 0 1" rpy="0 -1.5708 1.5708"/>
      <geometry>
        <cylinder radius="0.3" length="6.7"/>
      </geometry>
      <material name="silver">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="3.23 0 1" rpy="0 -1.5708 1.5708"/>
      <geometry>
        <cylinder radius="0.3" length="6.5"/>
      </geometry>
    </collision>
  </link>
  <joint name="rollcage_joint_23" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rollcage_23"/>
  </joint>

  <!-- Roll Cage Beam between wheel 3 and wheel 1 -->
  <link name="rollcage_31">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
               iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
    <visual>
      <!-- Midpoint at (-0.25, 0.433, 0); beam angle ψ = -2.61799 rad -->
      <origin xyz="-1.615 2.79718 1" rpy="0 -1.5708 -2.61799"/>
      <geometry>
                <cylinder radius="0.3" length="6.7"/>

      </geometry>
      <material name="silver">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="-1.615 2.79718 1" rpy="0 -1.5708 -2.61799"/>
      <geometry>
                <cylinder radius="0.3" length="6.7"/>

      </geometry>
    </collision>
  </link>
  <joint name="rollcage_joint_31" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="rollcage_31"/>
  </joint>

  

  <gazebo>
      <provideFeedback>true</provideFeedback>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/trikey_light</robotNamespace>
    </plugin>


    <!-- ros-noetic-gazebo-plugins -->


    <!-- FT sensor plugin for wheel 1 -->
    <plugin name="ft_sensor_plugin_1" filename="libgazebo_ros_ft_sensor.so">
      <ros>
        <namespace>/trikey_light</namespace>
        <remapping>~/ft : ft_sensor_1</remapping>
      </ros>
      <update_rate>100</update_rate>
            <frame>child</frame>
            <measure_direction>child_to_parent</measure_direction>
      <bodyName>wheel_link_1</bodyName>
      <jointName>wheel_joint_1</jointName>
      <sensorName>ft_sensor_wheel_1</sensorName>
      <topicName>ft_sensor_1_topic</topicName>
    </plugin>

    <!-- FT sensor plugin for wheel 2 -->
    <plugin name="ft_sensor_plugin_2" filename="libgazebo_ros_ft_sensor.so">
      <ros>
        <namespace>/trikey_light</namespace>
        <remapping>~/ft : ft_sensor_2</remapping>
      </ros>
      <update_rate>1000</update_rate>
      <frame>child</frame>
                  <measure_direction>child_to_parent</measure_direction>
      <bodyName>wheel_link_2</bodyName>
      <jointName>wheel_joint_2</jointName>
      <sensorName>ft_sensor_wheel_2</sensorName>
      <topicName>ft_sensor_2_topic</topicName>
    </plugin>

    <!-- FT sensor plugin for wheel 3 -->
    <plugin name="ft_sensor_plugin_3" filename="libgazebo_ros_ft_sensor.so">
      <ros>
        <namespace>/trikey_light</namespace>
        <remapping>~/ft : ft_sensor_3</remapping>
      </ros>
      <update_rate>100</update_rate>
            <frame>child</frame>
            <measure_direction>child_to_parent</measure_direction>
      <bodyName>wheel_link_3</bodyName>
      <jointName>wheel_joint_3</jointName>
      <sensorName>ft_sensor_wheel_3</sensorName>
      <topicName>ft_sensor_3_topic</topicName>
    </plugin>

  </gazebo>

</robot>